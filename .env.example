NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Copy the connection string from Supabase > Connect. Keep it in local .env only.
# Use Direct if the backend network supports IPv6; otherwise use Session pooler.
DATABASE_URL=

# Required only when binding API_HOST outside localhost. Never place in browser code.
API_BEARER_TOKEN=

# Opcional: servidor PostgreSQL para `npm run test:db` (pruebas de integración).
# Las pruebas crean y eliminan su propia base temporal; nunca usan la base de DATABASE_URL.
# Con `npx supabase start`: postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=

# --- Emisión electrónica (API) ---
# Envío real a SUNAT. Por defecto false: la API calcula, firma, guarda y genera PDF, sin enviar.
SUNAT_SEND_ENABLED=false
# beta (homologación) o production
SUNAT_ENVIRONMENT=beta
# Certificado digital .pfx/.p12 del servidor (obligatorio en producción). Guarda el archivo fuera de Git.
SUNAT_CERT_PATH=
SUNAT_CERT_PASSWORD=
