T, y, 86, A4_CONTENT - 100);\n      doc.font('Helvetica').fontSize(7).fillColor(MUTED).text('Representación impresa del comprobante electrónico. Verifique su validez en los canales oficiales de SUNAT.', A4_LEFT, y + 103, { width: A4_CONTENT });\n    });\n  }\n\n  private drawA4Header(doc: PdfDoc, cpe: PrintableCpe, y: number): void {\n    doc.font('Helvetica-Bold').fontSize(12).fillColor(NAVY).text(cpe.issuer.legalName, A4_LEFT, y, { width: 290 });\n    if (cpe.issuer.tradeName) doc.font('Helvetica').fontSize(8).fillColor(INK).text(cpe.issuer.tradeName, A4_LEFT, y + 17, { width: 290 });\n    let issuerY = y + (cpe.issuer.tradeName ? 31 : 20);\n    for (const line of [cpe.issuer.address, cpe.issuer.phone, cpe.issuer.email].filter(Boolean)) {\n      doc.font('Helvetica').fontSize(7.5).fillColor(MUTED).text(line!, A4_LEFT, issuerY, { width: 290 }); issuerY += 11;\n    }\n    const bx = 367, by = y, bw = 190, bh = 80;\n    doc.lineWidth(1.3).strokeColor(NAVY).rect(bx, by, bw, bh).stroke();\n    doc.rect(bx, by + 24, bw, 25).fill(PALE);\n    doc.font('Helvetica-Bold').fontSize(9).fillColor(INK).text(`R.U.C. ${cpe.issuer.ruc}`, bx + 5, by + 7, { width: bw - 10, align: 'center' });\n    doc.font('Helvetica-Bold').fontSize(9).fillColor(NAVY).text(documentTypeLabel(cpe.type), bx + 5, by + 31, { width: bw - 10, align: 'center' });\n    doc.font('Helvetica-Bold').fontSize(11).fillColor(INK).text(`${cpe.series}-${cpe.number}`, bx + 5, by + 56, { width: bw - 10, align: 'center' });\n  }\n\n  private drawA4Customer(doc: PdfDoc, cpe: PrintableCpe, y: number): number {\n    const h = 77;\n    doc.lineWidth(0.7).strokeColor(LINE).rect(A4_LEFT, y, A4_CONTENT, h).stroke();\n    doc.font('Helvetica-Bold').fontSize(8).fillColor(NAVY).text('DATOS DEL CLIENTE', A4_LEFT + 8, y + 7);\n    const rows: Array<[string, string]> = [\n      ['Señor(es):', cpe.customer.name],\n      ['Documento:', `${cpe.customer.documentType} ${cpe.customer.documentNumber}`],\n      ['Dirección:', cpe.customer.address || 'No consignada'],\n      ['Emisión / moneda:', `${cpe.issueDate}${cpe.issueTime ? ` ${cpe.issueTime}` : ''} / ${cpe.totals.currency}`],\n    ];\n    rows.forEach(([label, value], index) => {\n      const ry = y + 22 + index * 13;\n      doc.font('Helvetica-Bold').fontSize(7.5).fillColor(INK).text(label, A4_LEFT + 8, ry, { width: 105 });\n      doc.font('Helvetica').fontSize(7.5).fillColor(INK).text(value, A4_LEFT + 114, ry, { width: A4_CONTENT - 125 });\n    });\n    if (cpe.dueDate || cpe.paymentMethod) {\n      doc.font('Helvetica').fontSize(7.5).fillColor(MUTED).text([cpe.paymentMethod && `Pago: ${cpe.paymentMethod}`, cpe.dueDate && `Vence: ${cpe.dueDate}`].filter(Boolean).join('  |  '), A4_LEFT + 8, y + h - 10);\n    }\n    if (cpe.type === '07' && cpe.modifiedDocument) {\n      doc.font('Helvetica-Bold').fontSize(7.5).fillColor(NAVY).text(`Comprobante afectado: ${cpe.modifiedDocument.documentType} ${cpe.modifiedDocument.series}-${cpe.modifiedDocument.number}`, A4_LEFT, y + h + 4, { width: A4_CONTENT });\n      doc.font('Helvetica').fontSize(7).fillColor(INK).text(`Motivo: ${cpe.modifiedDocument.reasonCode} - ${cpe.modifiedDocument.reasonDescription}`, A4_LEFT, y + h + 15, { width: A4_CONTENT });\n      return y + h + 34;\n    }\n    return y + h + 13;\n  }\n\n  private drawA4Items(doc: PdfDoc, cpe: PrintableCpe, startY: number): number {\n    const widths = [44, 42, 226, 72, 78, 57];\n    const xs = [A4_LEFT]; for (const w of widths.slice(0, -1)) xs.push(xs[xs.length - 1] + w);\n    const headers = ['CANT.', 'U.M.', 'DESCRIPCIÓN', 'V. UNIT.', 'SUBTOTAL', 'TOTAL'];\n    let y = startY;\n    const drawHeader = () => {\n      doc.rect(A4_LEFT, y, A4_CONTENT, 20).fill(NAVY);\n      headers.forEach((h, i) => doc.font('Helvetica-Bold').fontSize(7).fillColor('#FFFFFF').text(h, xs[i] + 3, y + 6, { width: widths[i] - 6, align: i < 3 ? 'left' : 'right' }));\n      y += 24;\n    };\n    drawHeader();\n    for (const item of cpe.lines) {\n      const descHeight = doc.font('Helvetica').fontSize(7.5).heightOfString(item.description, { width: widths[2] - 8 });\n      const rowHeight = Math.max(19, descHeight + 8);\n      if (y + rowHeight > 760) { doc.addPage(); y = 36; drawHeader(); }\n      doc.font('Helvetica').fontSize(7.5).fillColor(INK);\n      const vals = [item.quantity.toString(), item.unitCode, item.description, money(item.unitPrice), money(item.lineExtensionAmount), money(item.totalAmount)];\n      vals.forEach((v, i) => doc.text(v, xs[i] + 3, y + 4, { width: widths[i] - 6, align: i < 3 ? 'left' : 'right', height: rowHeight - 4 }));\n      doc.moveTo(A4_LEFT, y + rowHeight).lineTo(A4_LEFT + A4_CONTENT, y + rowHeight).lineWidth(0.5).strokeColor(LINE).stroke();\n      y += rowHeight;\n    }\n    return y + 12;\n  }\n\n  private drawA4Totals(doc: PdfDoc, cpe: PrintableCpe, y: number): void {\n    if (cpe.totals.amountInWords) {\n      doc.rect(A4_LEFT, y, A4_CONTENT, 24).fill(PALE);\n      doc.font('Helvetica-Bold').fontSize(7.5).fillColor(INK).text(`SON: ${cpe.totals.amountInWords}`, A4_LEFT + 7, y + 8, { width: A4_CONTENT - 14 });\n      y += 32;\n    }\n    const labels: Array<[string, number]> = [\n      ['Operación gravada', cpe.totals.taxable], ['Operación exonerada', cpe.totals.exempt],\n      ['Operación inafecta', cpe.totals.unaffected], ['Operación gratuita', cpe.totals.free], ['IGV', cpe.totals.igv],\n    ];\n    const x = A4_LEFT + A4_CONTENT - 205;\n    labels.forEach(([label, amount]) => {\n      doc.font('Helvetica').fontSize(8).fillColor(INK).text(`${label}:`, x, y, { width: 125, align: 'right' });\n      doc.text(money(amount, cpe.totals.currency), x + 132, y, { width: 73, align: 'right' }); y += 13;\n    });\n    doc.moveTo(x, y).lineTo(x + 205, y).lineWidth(1).strokeColor(NAVY).stroke(); y += 5;\n    doc.font('Helvetica-Bold').fontSize(9).fillColor(NAVY).text('IMPORTE TOTAL:', x, y, { width: 125, align: 'right' });\n    doc.text(money(cpe.totals.total, cpe.totals.currency), x + 132, y, { width: 73, align: 'right' });\n  }\n\n  private drawQrAndHash(doc: PdfDoc, cpe: PrintableCpe, qr: Buffer, x: number, y: number, qrSize: number, textWidth: number): void {\n    doc.image(qr, x, y, { width: qrSize, height: qrSize });\n    const tx = x + qrSize + 12;\n    doc.font('Helvetica-Bold').fontSize(8).fillColor(NAVY).text('Hash CPE', tx, y + 3);\n    doc.font('Courier').fontSize(7).fillColor(INK).text(cpe.hashCpe, tx, y + 17, { width: textWidth, lineBreak: true });\n    doc.font('Helvetica').fontSize(7).fillColor(MUTED).text('Escanee el código QR para consultar los datos del comprobante.', tx, y + 43, { width: textWidth });\n  }\n\n  private renderTicket(cpe: PrintableCpe, qr: Buffer): Promise<Buffer> {\n    const width = 226.77; // 80 mm in points\n    const estimatedHeight = Math.max(420, 390 + cpe.lines.reduce((sum, line) => sum + 39 + Math.ceil(line.description.length / 28) * 9, 0));\n    return this.toBuffer(new PDFDocument({ size: [width, estimatedHeight], margins: { top: 12, bottom: 12, left: 10, right: 10 } }) as PdfDoc, (doc) => {\n      const left = 10, content = width - 20;\n      let y = 14;\n      const centered = (text: string, size = 8, bold = false) => { doc.font(bold ? 'Helvetica-Bold' : 'Helvetica').fontSize(size).fillColor(INK).text(text, left, y, { width: content, align: 'center' }); y += size + 5; };\n      const rule = () => { doc.moveTo(left, y).lineTo(width - left, y).dash(2, { space: 2 }).lineWidth(0.6).strokeColor(MUTED).stroke().undash(); y += 9; };\n      centered(cpe.issuer.legalName, 9, true);\n      centered(`R.U.C. ${cpe.issuer.ruc}`, 8);\n      if (cpe.issuer.address) centered(cpe.issuer.address, 7);\n      if (cpe.issuer.phone) centered(`Tel: ${cpe.issuer.phone}`, 7);\n      rule(); centered(documentTypeLabel(cpe.type), 9, true); centered(`${cpe.series}-${cpe.number}`, 10, true); rule();\n      const leftLine = (label: string, value: string) => { doc.font('Helvetica-Bold').fontSize(7).fillColor(INK).text(label, left, y, { width: 62 }); doc.font('Helvetica').fontSize(7).text(value, left + 62, y, { width: content - 62 }); y += Math.max(11, doc.heightOfString(value, { width: content - 62 }) + 3); };\n      leftLine('FECHA:', `${cpe.issueDate}${cpe.issueTime ? ` ${cpe.issueTime}` : ''}`);\n      leftLine('CLIENTE:', cpe.customer.name); leftLine('DOC.:', `${cpe.customer.documentType} ${cpe.customer.documentNumber}`);\n      if (cpe.customer.address) leftLine('DIRECCIÓN:', cpe.customer.address);\n      if (cpe.type === '07' && cpe.modifiedDocument) {\n        leftLine('AFECTA:', `${cpe.modifiedDocument.documentType} ${cpe.modifiedDocument.series}-${cpe.modifiedDocument.number}`);\n        leftLine('MOTIVO:', `${cpe.modifiedDocument.reasonCode} - ${cpe.modifiedDocument.reasonDescription}`);\n      }\n      leftLine('MONEDA:', cpe.totals.currency); if (cpe.paymentMethod) leftLine('PAGO:', cpe.paymentMethod); rule();\n      for (const item of cpe.lines) {\n        doc.font('Helvetica').fontSize(7).fillColor(INK).text(item.description, left, y, { width: content });\n        y += doc.heightOfString(item.description, { width: content }) + 3;\n        doc.font('Helvetica').fontSize(7).fillColor(MUTED).text(`${item.quantity} ${item.unitCode} x ${money(item.unitPrice, cpe.totals.currency)}`, left, y, { width: content - 70 });\n        doc.font('Helvetica-Bold').fontSize(7).fillColor(INK).text(money(item.totalAmount, cpe.totals.currency), left + content - 70, y, { width: 70, align: 'right' }); y += 12;\n      }\n      rule();\n      const totalLine = (label: string, value: number, bold = false) => {\n        doc.font(bold ? 'Helvetica-Bold' : 'Helvetica').fontSize(bold ? 8 : 7).fillColor(INK).text(label, left, y, { width: content - 78 });\n        doc.font(bold ? 'Helvetica-Bold' : 'Helvetica').fontSize(bold ? 8 : 7).text(money(value, cpe.totals.currency), left + content - 78, y, { width: 78, align: 'right' }); y += bold ? 14 : 11;\n      };\n      totalLine('Op. gravada', cpe.totals.taxable); totalLine('Op. exonerada', cpe.totals.exempt); totalLine('Op. inafecta', cpe.totals.unaffected); totalLine('IGV', cpe.totals.igv); totalLine('TOTAL A PAGAR', cpe.totals.total, true);\n      if (cpe.totals.amountInWords) { y += 2; centered(`SON: ${cpe.totals.amountInWords}`, 6.5); }\n      rule();\n      const qrSize = 92; doc.image(qr, (width - qrSize) / 2, y, { width: qrSize, height: qrSize }); y += qrSize + 5;\n      doc.font('Helvetica-Bold').fontSize(6.5).fillColor(NAVY).text('HASH CPE', left, y, { width: content, align: 'center' }); y += 9;\n      doc.font('Courier').fontSize(6).fillColor(INK).text(cpe.hashCpe, left, y, { width: content, align: 'center' }); y += 13;\n      centered('Representación impresa del comprobante electrónico', 6.5);\n      centered('Consulte su validez en los canales oficiales de SUNAT', 6.5);\n    });\n  }\n\n  private ensureSpace(doc: PdfDoc, y: number, needed: number): number {\n    if (y + needed > 790) { doc.addPage(); return 36; }\n    return y;\n  }\n\n  private toBuffer(doc: PdfDoc, draw: (doc: PdfDoc) => void): Promise<Buffer> {\n    return new Promise((resolve, reject) => {\n      const chunks: Buffer[] = [];\n      doc.on('data', (chunk: Buffer) => chunks.push(chunk));\n      doc.on('end', () => resolve(Buffer.concat(chunks)));\n      doc.on('error', reject);\n      try { draw(doc); doc.end(); } catch (error) { reject(error); }\n    });\n  }\n}\n"],"file":"/src/modules/printing/pdf-renderer.ts"}