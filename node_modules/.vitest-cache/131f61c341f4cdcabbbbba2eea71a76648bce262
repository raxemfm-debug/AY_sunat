class AuditLogger {
	logs = [];
	log(entry) {
		const record = {
			...entry,
			id: `aud_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
			timestamp: new Date().toISOString()
		};
		this.logs.push(record);
		return record;
	}
	getLogsByCompany(companyId) {
		return this.logs.filter((l) => l.companyId === companyId);
	}
}

