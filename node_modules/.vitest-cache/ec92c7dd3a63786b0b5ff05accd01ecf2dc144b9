//# vitestSourceMap={"mappings":"","names":[],"sources":["types.ts"],"version":3,"sourcesContent":["/**\n * TIPOS Y DEFINICIONES NORMATIVAS - SUNAT PERÚ\n * Régimen MYPE Tributario (D.L. 1269) y Sistema de Emisión Electrónica (SEE) UBL 2.1\n */\n\n// Catálogo 01: Tipo de Documento CPE\nexport type CpeTypeCode = '01' | '03' | '07'; // 01: Factura, 03: Boleta de Venta, 07: Nota de Crédito\n\n// Catálogo 06: Tipo de Documento de Identidad\nexport type IdentityDocTypeCode = \n  | '1' // DNI (8 dígitos)\n  | '4' // Carnet de Extranjería (hasta 12 dígitos)\n  | '6' // RUC (11 dígitos)\n  | '7' // Pasaporte (hasta 12 dígitos)\n  | '0'; // Documento no domiciliado / Sin documento\n\n// Catálogo 07: Tipo de Afectación al IGV\nexport type IgvAffectationCode =\n  | '10' // Gravado - Operación Onerosa\n  | '11' // Gravado - Retiro por premio\n  | '12' // Gravado - Retiro por donación\n  | '13' // Gravado - Retiro\n  | '14' // Gravado - Retiro por publicidad\n  | '15' // Gravado - Bonificaciones\n  | '16' // Gravado - Retiro por entrega a trabajadores\n  | '17' // Gravado - IVAP\n  | '20' // Exonerado - Operación Onerosa\n  | '21' // Exonerado - Transferencia gratuita\n  | '30' // Inafecto - Operación Onerosa\n  | '31' // Inafecto - Retiro por bonificación\n  | '32' // Inafecto - Retiro\n  | '33' // Inafecto - Retiro por muestras médicas\n  | '34' // Inafecto - Retiro por convenio colectivo\n  | '35' // Inafecto - Retiro por premio\n  | '36' // Inafecto - Retiro por publicidad\n  | '40'; // Exportación de bienes o servicios\n\n// Catálogo 09: Tipos de Nota de Crédito Electrónica\nexport type CreditNoteTypeCode =\n  | '01' // Anulación de la operación\n  | '02' // Anulación por error en el RUC\n  | '03' // Corrección por error en la descripción\n  | '04' // Descuento global\n  | '05' // Descuento por ítem\n  | '06' // Devolución total\n  | '07' // Devolución por ítem\n  | '08' // Bonificación\n  | '09' // Disminución en el valor\n  | '10' // Otros conceptos\n  | '11' // Ajustes de operaciones de exportación\n  | '12' // Ajustes afectos al IVAP\n  | '13'; // Corrección del monto neto pendiente de pago\n\n// Moneda según ISO 4217\nexport type CurrencyCode = 'PEN' | 'USD';\n\nexport interface CompanyProfile {\n  ruc: string; // 11 dígitos, empieza en 10 para Persona Natural con Negocio\n  legalName: string;\n  tradeName?: string;\n  taxRegime: 'MYPE_TRIBUTARIO';\n  address: {\n    ubigeo: string; // 6 dígitos\n    department: string;\n    province: string;\n    district: string;\n    urbanization?: string;\n    addressLine: string;\n  };\n  solCredentials?: {\n    usuarioSol: string;\n    claveSol: string;\n  };\n}\n\nexport interface ClientProfile {\n  docType: IdentityDocTypeCode;\n  docNumber: string;\n  name: string;\n  address?: string;\n  email?: string;\n}\n\nexport interface ItemCalculationInput {\n  id?: string;\n  code?: string;\n  description: string;\n  quantity: number | string;\n  unitCode?: string; // Catálogo 03: NIU (unidad), KGM (kilo), ZZ (servicio), etc. Default: NIU\n  unitPrice: number | string; // Precio de referencia\n  priceIncludesIgv: boolean; // true si unitPrice incluye el 18% IGV, false si es valor de venta neto\n  affectationType: IgvAffectationCode;\n  discountPercentage?: number | string;\n  discountAmount?: number | string;\n}\n\nexport interface CalculatedItem {\n  id?: string;\n  code?: string;\n  description: string;\n  quantity: string; // 2 a 10 decimales\n  unitCode: string;\n  unitValue: string; // Valor unitario sin tributos (redondeado a 2 o hasta 10 decimales según SUNAT)\n  unitPrice: string; // Precio unitario con tributos (para catálogo 16: precio venta unitario)\n  baseAmount: string; // Valor de venta neto del ítem antes de IGV\n  discountAmount: string; // Descuento aplicado\n  igvAmount: string; // IGV calculado para el ítem\n  totalAmount: string; // baseAmount + igvAmount (o 0 si es gratuito con transferencia no onerosa)\n  affectationType: IgvAffectationCode;\n  isGratuitous: boolean;\n  valueReferenceGratuitous?: string; // Valor referencial para operaciones gratuitas\n}\n\nexport interface CpeTotals {\n  operacionesGravadas: string; // Base imponible de operaciones gravadas (Código 1001 / Tag TaxSubtotal)\n  operacionesExoneradas: string; // Total operaciones exoneradas (Código 1003)\n  operacionesInafectas: string; // Total operaciones inafectas (Código 1002)\n  operacionesGratuitas: string; // Total operaciones gratuitas\n  totalDescuentos: string;\n  descuentoGlobal: string;\n  montoIgv: string; // Sumatoria de IGV\n  subTotal: string; // Suma de valores de venta (Gravadas + Exoneradas + Inafectas)\n  totalPagar: string; // Importe total a pagar (subTotal + montoIgv)\n  totalEnLetras: string;\n}\n\nexport interface CpeDocumentInput {\n  company: CompanyProfile;\n  client: ClientProfile;\n  cpeType: CpeTypeCode;\n  series: string; // F001/F002... para Facturas, B001/B002... para Boletas, FC01/BC01... para NC\n  correlative: number;\n  issueDate: string; // 'YYYY-MM-DD'\n  issueTime?: string; // 'HH:mm:ss'\n  dueDate?: string; // 'YYYY-MM-DD'\n  currency: CurrencyCode;\n  exchangeRate?: number | string; // Requerido si currency == 'USD'\n  paymentMethod: 'CONTADO' | 'CREDITO';\n  items: ItemCalculationInput[];\n  globalDiscountAmount?: number | string;\n  // Campos específicos para Nota de Crédito (07)\n  creditNoteInfo?: {\n    discrepancyCode: CreditNoteTypeCode;\n    discrepancyReason: string;\n    modifiedDocType: CpeTypeCode;\n    modifiedDocSeries: string;\n    modifiedDocCorrelative: number;\n  };\n}\n\nexport interface CpeDocumentCalculationResult {\n  header: {\n    cpeType: CpeTypeCode;\n    series: string;\n    correlative: number;\n    fullNumber: string; // e.g., F001-00000045\n    issueDate: string;\n    currency: CurrencyCode;\n    exchangeRate?: string;\n  };\n  client: ClientProfile;\n  items: CalculatedItem[];\n  totals: CpeTotals;\n  sunatXmlReadyPayload: Record<string, unknown>;\n}\n\n// Parámetros tributarios mensuales y anuales RMT\nexport interface RmtTaxYearConfig {\n  year: number;\n  uitValue: number | string; // UIT vigente para el año (e.g., 2026: 5350)\n  igvRate: number | string; // 0.18\n  rmtMonthlyRateLow: number | string; // 0.01 (1.0% para ingresos hasta 300 UIT)\n  rmtMonthlyRateHigh: number | string; // 0.015 (1.5% para ingresos > 300 UIT hasta 1700 UIT)\n  rmtThresholdUit: number; // 300\n}\n\nexport interface MonthlyTaxSettlementInput {\n  period: string; // 'YYYY-MM'\n  accumulatedNetRevenueBeforePeriod: number | string; // Ingresos netos acumulados de enero al mes anterior\n  salesTaxableBase: number | string; // Suma de bases imponibles gravadas de ventas (Facturas + Boletas - NC)\n  salesIgv: number | string; // Suma de IGV de ventas\n  purchasesTaxableBase: number | string; // Compras con derecho a crédito fiscal destinadas a ventas gravadas\n  purchasesIgv: number | string; // IGV de compras con derecho a crédito fiscal\n  previousFiscalCreditBalance?: number | string; // Saldo a favor de IGV del mes anterior (casilla 145 PDT 621)\n  previousIncomeTaxCreditBalance?: number | string; // Saldo a favor del I. Renta de meses o ejercicio anterior\n}\n\nexport interface MonthlyTaxSettlementResult {\n  period: string;\n  regime: 'MYPE_TRIBUTARIO';\n  uitApplicable: string;\n  \n  // IGV (Cuenta propia)\n  ventasGravadas: string;\n  debitoFiscalIgv: string;\n  comprasGravadas: string;\n  creditoFiscalIgv: string;\n  subtotalIgvPeriodo: string; // Débito - Crédito\n  saldoFavorIgvAnterior: string;\n  igvDeterminado: string; // Si Débito > Crédito + Saldo Anterior\n  igvPagar: string;\n  nuevoSaldoFavorIgvMesSiguiente: string; // Si Crédito + Saldo Anterior > Débito\n  \n  // Impuesto a la Renta (Pago a cuenta mensual RMT)\n  ingresosNetosMes: string;\n  ingresosNetosAcumulados: string;\n  limite300UitMonto: string;\n  supero300Uit: boolean;\n  tasaRentaAplicada: string; // '1.0%' o '1.5%'\n  cuotaRentaCalculada: string;\n  saldoFavorRentaAnterior: string;\n  rentaPagar: string;\n  nuevoSaldoFavorRentaMesSiguiente: string;\n  \n  // Resumen tributario a pagar\n  totalTributosAPagar: string;\n}\n"]}